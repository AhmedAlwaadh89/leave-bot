# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database URL (PostgreSQL recommended in production, e.g. Neon/Render/Heroku)
# Format: postgresql://username:password@host/database?sslmode=require
# Leave empty to use a local SQLite file (leave_management.db).
DATABASE_URL=

# Flask Secret Key (for web dashboard sessions / CSRF). Use a long random string.
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# Admin credentials for the web dashboard (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Optional: run the bot + scheduler inside the web process (default 1).
# Set to 0 if you run them as a separate worker process instead.
RUN_BOT_IN_WEB=1

# Optional scheduler times (server local time, usually UTC)
RENEWAL_CHECK_TIME=00:05
PENDING_REMINDER_TIME=06:00
PENDING_REMINDER_AGE_HOURS=24

# Optional keep-alive: ping <url>/health every N minutes so free hosting does not sleep.
# On Render this is automatic (RENDER_EXTERNAL_URL is provided by the platform).
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=10
